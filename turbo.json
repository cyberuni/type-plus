{
	"$schema": "https://turborepo.org/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": [
				"src/",
				"!src/**/*.{spec,test,unit,accept,integrate,system,perf,stress,stories}.{ts,tsx}",
				"scripts/",
				"tsconfig*.json"
			],
			"outputs": ["lib/**", "cjs/**", "esm/**", "dist/**", ".astro/**"]
		},
		"website#build": {
			"dependsOn": ["^build"],
			"inputs": ["astro.config.mjs", "src/", "public/", "tsconfig.json"],
			"outputs": ["dist/**", ".astro/**"]
		},
		"clean": {
			"cache": false
		},
		"coverage": {
			"dependsOn": ["^build"],
			"inputs": ["src/"],
			"outputs": ["coverage/**"]
		},
		"knip": {},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"lint": {},
		"nuke": {
			"cache": false
		},
		"size": {
			"dependsOn": ["build"]
		},
		"test": {
			"dependsOn": ["^build"],
			"inputs": ["src/"]
		},
		"test:type": {
			"dependsOn": ["^build"],
			"inputs": ["src/"]
		},
		"test:type:latest": {
			"dependsOn": ["^build"],
			"inputs": ["src/"]
		},
		"test:type:54": {
			"dependsOn": ["^build"],
			"inputs": ["src/"]
		},
		"test:type:55": {
			"dependsOn": ["^build"],
			"inputs": ["src/"]
		},
		"test:type:56": {
			"dependsOn": ["^build"],
			"inputs": ["src/"]
		},
		"test:type:60": {
			"dependsOn": ["^build"],
			"inputs": ["src/"]
		},
		"verify:dts": {
			"dependsOn": ["build"],
			"inputs": ["esm/**/*.d.ts", "tsconfig.dts.json"]
		}
	}
}
